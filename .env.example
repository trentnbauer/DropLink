# Which image to run: latest, or a release such as 0.3.0 (see the Releases page). Update with: docker compose pull
DROPLINK_VERSION=latest

# Port the web app listens on (point your Cloudflare Tunnel or reverse proxy here).
WEBPORT=3000

# Name or IP that devices OUTSIDE your network use to reach the relay. If it is a name, make it a plain DNS
# record (in Cloudflare: grey cloud / DNS only, the proxy does not carry TURN).
TURN_HOST=turn.example.com

# Shared secret between the app and the relay. Generate one:  openssl rand -hex 24
TURN_SECRET=

# Only if this machine sits behind a router doing NAT: PUBLIC_IP/LAN_IP, e.g. 203.0.113.5/10.0.0.246
TURN_EXTERNAL_IP=

# Optional: Cloudflare Tunnel token (docker compose --profile tunnel up -d)
TUNNEL_TOKEN=

# --- Dockflare (docker-compose.dockflare.yml): uncomment and fill in ---
# DOMAIN=example.com
# SUBDOMAIN=droplink.            # keep the trailing dot; leave empty to use the bare domain
# HOSTNAME=latte                 # this machine's name, as the Dockflare tunnel reaches it
# DF_POLICY=tld_default          # Zero Trust access policy
# DF_APPNAME=DropLink
# NO_TLS_VERIFY=false
